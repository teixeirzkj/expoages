# -----------------------------------------------------------------------------
# Projeto Horizonte — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o arquivo .env.local.
# Sem estas variáveis o projeto funciona apenas no modo demonstração.
# -----------------------------------------------------------------------------

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publicável (sb_publishable_...) ou a chave "anon" legada.
# É lida apenas no servidor. A segurança é garantida por RLS.
SUPABASE_PUBLISHABLE_KEY=

# Alternativa aceita, caso use o nome legado:
# SUPABASE_ANON_KEY=

# NÃO configure a service_role key: a aplicação não precisa dela.
